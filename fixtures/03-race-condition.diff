 package stats
 
+import "sync"
+
+type RequestStats struct {
+	mu     sync.Mutex
+	counts map[string]int
+}
+
+func NewRequestStats() *RequestStats {
+	return &RequestStats{counts: make(map[string]int)}
+}
+
+// Inc records one request for the given path.
+func (s *RequestStats) Inc(path string) {
+	s.mu.Lock()
+	s.counts[path]++
+	s.mu.Unlock()
+}
+
+// Count returns the number of requests recorded for the given path.
+func (s *RequestStats) Count(path string) int {
+	return s.counts[path]
+}
+
+// Snapshot returns the current counts.
+func (s *RequestStats) Snapshot() map[string]int {
+	return s.counts
+}
