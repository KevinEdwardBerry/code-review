+-- User queries
 
 
+CREATE PROCEDURE FindUserByName
+    @name NVARCHAR(255)
+AS
+BEGIN
+    DECLARE @query NVARCHAR(MAX)
+    SET @query = 'SELECT id, name, email FROM users WHERE name = ''' + @name + ''''
+    EXEC sp_executesql @query
+END
+
+SELECT id, name, email FROM users WHERE name = '" + name + "'"
