@@ -1,6 +1,18 @@
 import sqlite3
 
 
 def get_db():
     return sqlite3.connect("app.db")
+
+
+def find_user_by_name(name):
+    conn = get_db()
+    cur = conn.cursor()
+    query = "SELECT id, name, email FROM users WHERE name = '" + name + "'"
+    cur.execute(query)
+    row = cur.fetchone()
+    conn.close()
+    return row
