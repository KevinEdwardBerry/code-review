@@ -1,6 +1,18 @@
+-- User queries
 
 
+CREATE OR ALTER PROCEDURE FindUserByName
+    @name nvarchar(255)
+AS
+BEGIN
+    SET NOCOUNT ON;
+    DECLARE @query nvarchar(1023);
+    SET @query = 'SELECT id, name, email FROM users WHERE name = ''' + @name + '''';
+    EXEC sp_executesql @query;
+END
+GO
