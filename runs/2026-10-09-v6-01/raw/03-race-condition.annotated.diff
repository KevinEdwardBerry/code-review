   9 | +
  10 | +    public void Inc(string path)
  11 | +    {
  12 | +        if (counts.TryGetValue(path, out var count))
  13 | +            counts[path] = count + 1;
  14 | +        else
  15 | +            counts[path] = 1;
  16 | +    }
  17 | +
  18 | +    public int Count(string path)
  19 | +    {
